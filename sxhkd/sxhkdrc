# Увеличить звук на 5%
XF86AudioRaiseVolume
    pamixer -i 5

# Уменьшить звук на 5%
XF86AudioLowerVolume
    pamixer -d 5

# Включить/выключить звук (Mute)
XF86AudioMute
    pamixer -t

